# Normalize line endings: store as LF in repo, checkout as native on each OS
* text=auto

# Force PHP/HTML/CSS/JS to always use LF
*.php text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.env text eol=lf

# Binary files — never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg binary
*.ttf binary
*.woff binary
*.woff2 binary
*.zip binary
*.sqlite binary
